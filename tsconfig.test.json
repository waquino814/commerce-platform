{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "apps/*/test/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts"
  ],
  // The Commerce UI's tests are browser code, typechecked with apps/commerce-web/tsconfig.json.
  "exclude": ["apps/commerce-web/**"]
}
