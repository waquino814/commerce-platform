{
  "$id": "https://commerce-platform.local/schemas/incident-bundle/v1/logs-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "attributes": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "level": {
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal",
        "unknown"
      ],
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "service": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "span_id": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "service",
    "time",
    "level",
    "message",
    "attributes"
  ],
  "title": "Incident bundle logs-record (schema 1.0.0)",
  "type": "object"
}
