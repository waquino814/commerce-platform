              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "source",
            "stepSeconds",
            "series"
          ],
          "type": "object"
        },
        "traces": {
          "additionalProperties": {},
          "properties": {
            "droppedAdminSpans": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "maxTracesPerService": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "minSliceSeconds": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "searchDepth": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "services": {
              "items": {
                "additionalProperties": {},
                "properties": {
                  "name": {
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "type": "string"
                  },
                  "saturatedSlices": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "traces": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "truncationReasons": {
                    "items": {
                      "enum": [
                        "slice_saturated",
                        "service_cap"
