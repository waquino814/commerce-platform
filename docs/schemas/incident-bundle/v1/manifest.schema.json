{
  "$id": "https://commerce-platform.local/schemas/incident-bundle/v1/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "bundleId": {
      "pattern": "^[a-z][a-z0-9-]*-\\d+-\\d{8}T\\d{6}Z$",
      "type": "string"
    },
    "capture": {
      "additionalProperties": {},
      "properties": {
        "logs": {
          "additionalProperties": {},
          "properties": {
            "services": {
              "items": {
                "additionalProperties": {},
                "properties": {
                  "droppedAdminLines": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "name": {
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "type": "string"
                  },
                  "nonJsonLines": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "records": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "records",
                  "nonJsonLines",
