        "metrics": {
          "additionalProperties": {},
          "properties": {
            "series": {
              "items": {
                "additionalProperties": {},
                "properties": {
                  "name": {
                    "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$",
                    "type": "string"
                  },
                  "seriesCount": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "seriesCount"
