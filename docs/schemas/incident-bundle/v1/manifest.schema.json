            "records": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "type": "object"
