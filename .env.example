# Local configuration for pnpm commands run on the host (db:migrate, dev, test).
# Docker Compose sets container configuration itself and only reads POSTGRES_PORT and LOG_LEVEL here.
# Copy to .env. Credentials below are local-only defaults.

# Postgres connection used by db:migrate and the apps in dev mode.
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce
# Separate database used by integration tests. Created by infra/postgres/init.
TEST_DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce_test
# Host port that Compose publishes Postgres on.
POSTGRES_PORT=5432
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# orders-api HTTP port.
PORT=3000

# Target of `pnpm loadgen` (M4): the orders API's base URL. Defaults to http://localhost:3000.
# ORDERS_API_URL=http://localhost:3000

# worker identity recorded in orders.claimed_by. Defaults to the hostname.
WORKER_ID=worker-local
# Delay between polls when no full batch was claimed.
POLL_INTERVAL_MS=1000
# Maximum orders claimed per poll.
CLAIM_BATCH_SIZE=10
# worker health server port (/healthz, /readyz).
HEALTH_PORT=3001

# --- Order processing (M2). Defaults shown. See docs/prompts/m2-design.md. ---
# Orders one worker processes at once. The worker claims only free slots.
WORKER_CONCURRENCY=5
# A claim older than this is returned by recovery. Must be >= 1.5 x the processing budget
# (2 x DB_CONNECT_TIMEOUT_MS + 11 x DB_STATEMENT_TIMEOUT_MS + 2 x PAYMENT_TIMEOUT_MS = 36 s).
CLAIM_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=2000
# Payment simulator: the worker's timeout per call, and the simulated processing time.
PAYMENT_TIMEOUT_MS=5000
PAYMENT_LATENCY_MS=50
# Claims allowed before an order is only reconciled. Must exceed MAX_CHARGE_ATTEMPTS.
MAX_CLAIMS=10
# Charge requests per order (the payment retry budget).
MAX_CHARGE_ATTEMPTS=3
# Lookup errors before an order is parked in payment_unknown.
MAX_RECONCILIATION_ATTEMPTS=5
# Backoff: min(base x 2^(n-1), max). Minimums: retry 100, reconciliation 1000.
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RECONCILIATION_BASE_DELAY_MS=5000
RECONCILIATION_MAX_DELAY_MS=60000
# Recheck interval for payment_unknown orders. Minimum 60000.
PAYMENT_UNKNOWN_RECHECK_MS=900000

# --- Telemetry (M3). Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set. See docs/prompts/m3-design.md. ---
# Collector base URL. Compose sets it for the containers. Setting it alone does not enable telemetry
# for `pnpm dev`: that workflow runs the TypeScript sources through tsx without the production
# preload, so nothing is instrumented. To send telemetry from host-run apps to the Compose collector,
# build them and start each with its preload, for example:
#   pnpm build
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 node --env-file=.env \
#     --import ./apps/worker/dist/telemetry.js apps/worker/dist/main.js
# (use ./apps/orders-api/dist/telemetry.js and apps/orders-api/dist/main.js for the API).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true disables telemetry even when an endpoint is set.
OTEL_SDK_DISABLED=false
# Resource attributes. Defaults: orders-api or worker; WORKER_ID or the hostname.
# OTEL_SERVICE_NAME=
# OTEL_SERVICE_INSTANCE_ID=
# Per-export timeout and span batch delay, in ms.
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_BSP_SCHEDULE_DELAY=1000
# Metric export interval and timeout, in ms. The interval must be >= the timeout.
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=3000
# Worker order-status sampler interval (M3c).
METRICS_SAMPLE_INTERVAL_MS=5000
