# Local configuration for pnpm commands run on the host (db:migrate, dev, test).
# Docker Compose sets container configuration itself and only reads POSTGRES_PORT and LOG_LEVEL here.
# Copy to .env. Credentials below are local-only defaults.

# Postgres connection used by db:migrate and the apps in dev mode.
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce
# Separate database used by integration tests. Created by infra/postgres/init.
TEST_DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce_test
# Host port that Compose publishes Postgres on.
POSTGRES_PORT=5432
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# orders-api HTTP port.
PORT=3000

# worker identity recorded in orders.claimed_by. Defaults to the hostname.
WORKER_ID=worker-local
# Delay between polls when no full batch was claimed.
POLL_INTERVAL_MS=1000
# Maximum orders claimed per poll.
CLAIM_BATCH_SIZE=10
# worker health server port (/healthz, /readyz).
HEALTH_PORT=3001
